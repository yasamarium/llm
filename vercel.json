{
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/health.js": { "maxDuration": 60 },
    "api/image.js": { "maxDuration": 60 },
    "api/chat.js": { "maxDuration": 60 },
    "api/edit-image.js": { "maxDuration": 60 },
    "api/proxy-image.js": { "maxDuration": 60 },
    "api/i.js": { "maxDuration": 60 },
    "api/s.js": { "maxDuration": 60 },
    "api/msg.js": { "maxDuration": 60 },
    "api/youtube.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/", "destination": "/chat.html" },
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/insta", "destination": "/insta.html" },
    { "source": "/download", "destination": "/insta.html" },
    { "source": "/yt", "destination": "/yt.html" },
    { "source": "/youtube", "destination": "/youtube.html" },
    { "source": "/music", "destination": "/music.html" },
    { "source": "/home", "destination": "/home.html" },
    { "source": "/webeditor", "destination": "/webeditor.html" },
    { "source": "/game", "destination": "/game.html" },
    { "source": "/telegram", "destination": "/telegram.html" },
    { "source": "/updates", "destination": "/updates.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/api/youtube", "destination": "/api/youtube.js" },
    { "source": "/api/music", "destination": "/api/health?action=music" },
    { "source": "/api/telegram", "destination": "/api/health?action=telegram" },
    { "source": "/api/updates", "destination": "/api/health?action=channel" },
    { "source": "/api/bot", "destination": "/api/health?action=bot" },
    { "source": "/i/:id*", "destination": "/api/i?id=:id*" },
    { "source": "/s/:id*", "destination": "/api/s?id=:id*" }
  ]
}
