# yasamarium/llm Environment Variables (Optional - defaults are built into the code)

# The public URL of your yasamarium/llmserver backend
# e.g., Cloudflare Tunnel URL (https://xyz.trycloudflare.com or https://api.yourdomain.com)
LLMSERVER_URL=http://localhost:8000

# Secret API key matching API_KEY in yasamarium/llmserver
LLMSERVER_API_KEY=

# Telegram API Configuration (Silent Read-Only Profile Resolver)
TELEGRAM_API_ID=35328182
TELEGRAM_API_HASH=24e4690a9b3fa242311bbe5b1586f13c
